# Copiá este archivo a deploy/.env en el servidor y completalo. NUNCA lo subas a git.

# Base de datos: una contraseña larga al azar (por ejemplo: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Login: hash de tu contraseña. Generalo con:
#   docker run --rm ghcr.io/gabrielguzman/gyrfinanzas-api:latest python -m app.auth "tu contraseña"
APP_PASSWORD_HASH=
# Clave para firmar la sesión (openssl rand -hex 32). Si la cambiás, se cierran todas las sesiones.
SECRET_KEY=
# true si se entra por HTTPS (lo normal en producción)
COOKIE_SECURE=true

# Puerto local de la web (solo 127.0.0.1). Elegí uno libre: tu proxy apunta el dominio acá.
WEB_PORT=3410

# Bot de Telegram (opcional): poné el token y descomentá COMPOSE_PROFILES
TELEGRAM_TOKEN=
TELEGRAM_CODIGO=
# COMPOSE_PROFILES=bot

# Lectura de resúmenes con IA (opcional)
ANTHROPIC_API_KEY=

# Backups: hora del día (00-23) y cuántos días se guardan
BACKUP_HORA=04
BACKUP_DIAS=14

TZ=America/Argentina/Catamarca
